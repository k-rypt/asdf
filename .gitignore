# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/packages/*/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
.next/
/out/

# production
/build
public/pyodide/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local tooling (agent/editor caches, not project source)
/.github/copilot-instructions.md
/.playwright-mcp/
/.serena/
/supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

#graphify
/graphify-out/

# superpowers scratch workspace (ledgers, briefs, review packages)
/.superpowers/
/docs/superpowers/

# stray contributor build artifacts accidentally committed from an
# absolute local path (e.g. Users/<name>/.../.next/...)
/Users/
*.docx

# self-hosted Pyodide runtime, copied from node_modules by scripts/copy-pyodide.mjs
/public/pyodide/
node_modules
.env
.env.*
