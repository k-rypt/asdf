{
  "name": "@assessment-toolkit/core",
  "version": "0.1.0",
  "description": "Framework-agnostic types, hooks, and grading logic for the assessment toolkit. No database or UI-framework imports — talks to your backend only through an injected AssessmentApiClient.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./server": { "types": "./src/server/index.ts", "default": "./src/server/index.ts" }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": { "react": ">=18", "groq-sdk": "^1.2.0" },
  "peerDependenciesMeta": { "groq-sdk": { "optional": true } },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "groq-sdk": "^1.2.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
